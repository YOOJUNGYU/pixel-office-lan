<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Login agent: starts the office in the background. __HOME__ is filled in by postinstall. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pixeloffice.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Pixel Office.app/Contents/Resources/node</string>
    <string>/Applications/Pixel Office.app/Contents/Resources/app/cli.js</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- Restart after a crash, but not after a clean exit (POST /api/quit, already running). -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/PixelOffice.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/PixelOffice.log</string>
</dict>
</plist>
